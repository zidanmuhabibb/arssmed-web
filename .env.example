# Salin ke .env.local. Jangan commit nilai asli.
# Nilai lokal muncul setelah `pnpm db:start` (butuh Docker Desktop).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Kunci publik (publishable / anon). Aman di browser; akses dibatasi RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Kunci rahasia (secret / service_role). HANYA server, jangan pernah diberi awalan NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Alamat aplikasi yang dicetak di kartu masuk siswa.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Opsional — demo/uji tanpa Supabase (data di memori, hilang saat server mati):
# ARSSMED_BACKEND=memory
